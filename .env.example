# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Not used by the app yet; never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# App (public URL, used in WhatsApp messages, campaign links and social previews)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Business WhatsApp in international format, digits only (e.g. 59170000000).
# All WhatsApp buttons are hidden while this is empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Support email shown on Help and in the footer (hidden while empty).
NEXT_PUBLIC_SUPPORT_EMAIL=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loaded only after cookie consent.
NEXT_PUBLIC_GA_ID=
